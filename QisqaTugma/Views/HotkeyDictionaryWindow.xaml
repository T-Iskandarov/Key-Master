<Window x:Class="QisqaTugma.Views.HotkeyDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qisqa Tugmalar Lug'ati" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="White"
        Loaded="Window_Loaded">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnAddTab" Content="Yangi bo'lim (Tab) qo'shish" Width="170" Height="30" Click="AddCategory_Click"/>
            <Button x:Name="BtnDeleteTab" Content="Tanlangan bo'limni o'chirish" Width="170" Height="30" Margin="10,0,0,0" Click="DeleteCategory_Click" Foreground="Red"/>
        </StackPanel>

        <TabControl x:Name="CategoriesTabControl" Grid.Row="1" Margin="0,0,0,10" SelectionChanged="CategoriesTabControl_SelectionChanged">
            <!-- Tabs added dynamically in code behind -->
        </TabControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="NewKeyCombo" Grid.Column="0" Margin="0,0,5,0" Height="26" VerticalContentAlignment="Center"/>
            <TextBox x:Name="NewDescription" Grid.Column="1" Margin="0,0,10,0" Height="26" VerticalContentAlignment="Center"/>
            <Button x:Name="BtnAddRow" Grid.Column="2" Content="Yangi qo'shish" Width="120" Height="30" Margin="0,0,10,0" Click="AddHotkey_Click"/>
            <Button x:Name="BtnDeleteRow" Grid.Column="3" Content="O'chirish" Width="100" Height="30" Click="DeleteHotkey_Click" Foreground="Red"/>
        </Grid>
    </Grid>
</Window>

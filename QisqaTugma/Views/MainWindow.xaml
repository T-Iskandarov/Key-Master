<Window x:Class="QisqaTugma.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key Master - Sozlamalar"
        Width="520" Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Width" Value="160"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,15">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="⌨️ Key Master" FontSize="22" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Klaviatura vizualizatori sozlamalari" FontSize="12" Foreground="Gray" Margin="0,0,0,10"/>
                <Separator/>

                <!-- Tema -->
                <StackPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Tema:" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="ThemeCombo" Width="140" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Yorug' (Light)" Tag="Light"/>
                        <ComboBoxItem Content="Qorong'i (Dark)" Tag="Dark"/>
                    </ComboBox>
                </StackPanel>

                <!-- Ko'rinish sozlamalari -->
                <TextBlock Text="📐 Ko'rinish" Style="{StaticResource SectionHeader}"/>

                <StackPanel Style="{StaticResource SettingRow}">
                    <TextBlock x:Name="LblLanguage" Text="Til / Language:" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="LanguageCombo" Width="160" SelectionChanged="LanguageCombo_Changed">
                        <ComboBoxItem Content="O'zbekcha (Lotin)" Tag="uz" IsSelected="True"/>
                        <ComboBoxItem Content="Qoraqalpoqcha (Karakalpak)" Tag="kaa"/>
                        <ComboBoxItem Content="English (Inglizcha)" Tag="en"/>
                        <ComboBoxItem Content="Русский (Russian)" Tag="ru"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Style="{StaticResource SettingRow}">
                    <TextBlock x:Name="LblTextColor" Text="Matn rangi:" Style="{StaticResource Label}"/>
                    <Border x:Name="TextColorPreview" Width="30" Height="24" BorderBrush="Gray"
                            BorderThickness="1" CornerRadius="3" Cursor="Hand"
                            MouseLeftButtonUp="TextColorPreview_Click" Margin="0,0,8,0"/>
                    <TextBox x:Name="TextColorBox" Width="90" VerticalAlignment="Center"
                             TextChanged="TextColorBox_Changed"/>
                </StackPanel>

                <StackPanel Style="{StaticResource SettingRow}">
                    <TextBlock x:Name="LblBgColor" Text="Orqa fon rangi:" Style="{StaticResource Label}"/>
                    <Border x:Name="BgColorPreview" Width="30" Height="24" BorderBrush="Gray"
                            BorderThickness="1" CornerRadius="3" Cursor="Hand"
                            MouseLeftButtonUp="BgColorPreview_Click" Margin="0,0,8,0"/>
                    <TextBox x:Name="BgColorBox" Width="90" VerticalAlignment="Center"
                             TextChanged="BgColorBox_Changed"/>
                </StackPanel>

                <StackPanel Style="{StaticResource SettingRow}">
                    <TextBlock x:Name="LblFontSize" Text="Shrift o'lchami:" Style="{StaticResource Label}"/>
                    <Slider x:Name="FontSizeSlider" Width="150" Minimum="12" Maximum="72"
                            TickFrequency="2" IsSnapToTickEnabled="True"
                            ValueChanged="FontSizeSlider_Changed"/>
                    <TextBlock x:Name="FontSizeLabel" Text="28" Margin="8,0,0,0"
                               VerticalAlignment="Center" Width="30"/>
                </StackPanel>

                <StackPanel Style="{StaticResource SettingRow}">
                    <TextBlock x:Name="LblPosition" Text="Ekrandagi pozitsiya:" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="PositionCombo" Width="160" SelectionChanged="PositionCombo_Changed">
                        <ComboBoxItem Content="Yuqori-Chap" Tag="TopLeft"/>
                        <ComboBoxItem Content="Yuqori-Markaz" Tag="TopCenter"/>
                        <ComboBoxItem Content="Yuqori-O'ng" Tag="TopRight"/>
                        <ComboBoxItem Content="Markaz-Chap" Tag="CenterLeft"/>
                        <ComboBoxItem Content="Markaz" Tag="Center"/>
                        <ComboBoxItem Content="Markaz-O'ng" Tag="CenterRight"/>
                        <ComboBoxItem Content="Pastki-Chap" Tag="BottomLeft"/>
                        <ComboBoxItem Content="Pastki-Markaz" Tag="BottomCenter" IsSelected="True"/>
                        <ComboBoxItem Content="Pastki-O'ng" Tag="BottomRight"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Style="{StaticResource SettingRow}">
                    <TextBlock x:Name="LblDuration" Text="Ko'rinish davomiyligi:" Style="{StaticResource Label}"/>
                    <Slider x:Name="DurationSlider" Width="150" Minimum="0.5" Maximum="5"
                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                            ValueChanged="DurationSlider_Changed"/>
                    <TextBlock x:Name="DurationLabel" Text="2.0s" Margin="8,0,0,0"
                               VerticalAlignment="Center" Width="40"/>
                </StackPanel>

                <Separator Margin="0,8"/>

                <!-- Funksiyalar -->
                <TextBlock x:Name="HeaderFeatures" Text="🚀 Funksiyalar" Style="{StaticResource SectionHeader}"/>

                <CheckBox x:Name="ShowAllKeysCheck" Content="Barcha tugmalarni ko'rsatish"
                          Margin="0,4" Checked="FeatureCheck_Changed" Unchecked="FeatureCheck_Changed"/>

                <CheckBox x:Name="OnlyFunctionalCheck" Content="Faqat funksional tugmalar (Ctrl, Alt, Shift, Win, F1-F12...)"
                          Margin="0,4" Checked="FeatureCheck_Changed" Unchecked="FeatureCheck_Changed"/>

                <CheckBox x:Name="VirtualKeyboardCheck" Content="Virtual klaviatura (Ctrl+F12)"
                          Margin="0,4" Checked="FeatureCheck_Changed" Unchecked="FeatureCheck_Changed"/>

                <CheckBox x:Name="DoubleCtrlSpotlightCheck" Content="Ctrl 2x bosish — qoramtir fon (Spotlight)"
                          Margin="0,4" Checked="FeatureCheck_Changed" Unchecked="FeatureCheck_Changed"/>

                <CheckBox x:Name="KeySoundCheck" Content="Tugma ovozi (mexanik klaviatura)"
                          Margin="0,4" Checked="FeatureCheck_Changed" Unchecked="FeatureCheck_Changed"/>

                <CheckBox x:Name="ShowMouseClicksCheck" Content="Sichqoncha bosilishini ko'rsatish (chap, o'ng, scroll)"
                          Margin="0,4" Checked="FeatureCheck_Changed" Unchecked="FeatureCheck_Changed"/>

                <CheckBox x:Name="ClickAnimationCheck" Content="Sichqoncha bosish animatsiyasi"
                          Margin="0,4" Checked="FeatureCheck_Changed" Unchecked="FeatureCheck_Changed"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                    <CheckBox x:Name="HotkeyDescCheck" Content="Qisqa tugma ta'riflarini ko'rsatish"
                              VerticalAlignment="Center" Checked="FeatureCheck_Changed" Unchecked="FeatureCheck_Changed"/>
                    <Button x:Name="BtnDatabase" Content="Ma'lumotlar bazasi" Width="130" Height="24" Margin="15,0,0,0"
                            Click="OpenDictionary_Click"/>
                </StackPanel>

                <Separator Margin="0,8"/>

                <!-- Qo'shimcha sozlamalar -->
                <TextBlock x:Name="HeaderExtra" Text="⚙ Qo'shimcha" Style="{StaticResource SectionHeader}"/>

                <StackPanel Style="{StaticResource SettingRow}">
                    <TextBlock x:Name="LblAnimType" Text="Klik animatsiya turi:" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="AnimTypeCombo" Width="140" SelectionChanged="AnimType_Changed">
                        <ComboBoxItem Content="Ripple (to'lqin)" Tag="Ripple" IsSelected="True"/>
                        <ComboBoxItem Content="Shrink (kichrayish)" Tag="Shrink"/>
                        <ComboBoxItem Content="Flash (yonish)" Tag="Flash"/>
                        <ComboBoxItem Content="Ring (halqa)" Tag="Ring"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Style="{StaticResource SettingRow}">
                    <TextBlock x:Name="LblClickColor" Text="Klik animatsiya rangi:" Style="{StaticResource Label}"/>
                    <Border x:Name="ClickColorPreview" Width="30" Height="24" BorderBrush="Gray"
                            BorderThickness="1" CornerRadius="3" Cursor="Hand"
                            MouseLeftButtonUp="ClickColorPreview_Click" Margin="0,0,8,0"/>
                    <TextBox x:Name="ClickColorBox" Width="90" VerticalAlignment="Center"
                             TextChanged="ClickColorBox_Changed"/>
                </StackPanel>

                <StackPanel Style="{StaticResource SettingRow}">
                    <TextBlock x:Name="LblSpotlightRadius" Text="Spotlight radiusi:" Style="{StaticResource Label}"/>
                    <Slider x:Name="SpotlightSlider" Width="150" Minimum="50" Maximum="300"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            ValueChanged="SpotlightSlider_Changed"/>
                    <TextBlock x:Name="SpotlightLabel" Text="150" Margin="8,0,0,0"
                               VerticalAlignment="Center" Width="30"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="BtnSave" Content="Saqlash" Width="100" Height="32" Margin="0,0,8,0"
                            Click="SaveButton_Click" FontWeight="SemiBold"/>
                    <Button x:Name="BtnClose" Content="Yopish" Width="80" Height="32"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Reklama Banneri -->
        <Border Grid.Row="1" Background="#E5F3FF" BorderBrush="#0078D7" BorderThickness="0,2,0,0" Padding="15,10" Cursor="Hand" MouseLeftButtonUp="Banner_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/Resources/cubo-logo.png" Width="50" Height="50" Margin="0,0,15,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Ishlab chiqaruvchi: Cubo.uz" FontWeight="SemiBold" FontSize="15" Foreground="#000000"/>
                    <TextBlock Text="Muallif: Tursunpo'lat Iskandarov" FontSize="13" Foreground="#555555" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
